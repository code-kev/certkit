{
  "extends": [
    "@tsconfig/strictest/tsconfig.json",
    "@tsconfig/node22/tsconfig.json"
  ],
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "verbatimModuleSyntax": true,
    "isolatedDeclarations": true,
    "noUncheckedIndexedAccess": true,
    "erasableSyntaxOnly": true,
    "declaration": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts"]
}
